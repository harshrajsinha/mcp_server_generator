# ScikiQ Database MCP Server Environment Configuration
# 
# This file contains database connection credentials for the MCP server.
# Format: CONNECTIONID_PARAMETER=value
#
# Supported parameters for each connection:
# - DB_TYPE: Database type (MYSQL, POSTGRES, ORACLE, SQLSERVER, etc.)
# - HOSTNAME: Database server hostname/IP
# - PORT: Database port number
# - DATABASE: Database name
# - USERNAME: Database username
# - PASSWORD: Database password
# - SCHEMA: Database schema (optional)
# - SSL_MODE: SSL connection mode (optional)
# - SSL_CERT: SSL certificate path (optional)
# - SSL_KEY: SSL key path (optional)
# - SSL_CA: SSL CA certificate path (optional)

# Example: Production MySQL Database
# MySQL Production (DBFactory compatible format)
PROD_MYSQL_DB_TYPE=MYSQL
PROD_MYSQL_HOSTNAME=prod-mysql.example.com
PROD_MYSQL_PORT=3306
PROD_MYSQL_DATABASE=production
PROD_MYSQL_USERNAME=prod_user
PROD_MYSQL_PASSWORD=prod_password_123
PROD_MYSQL_SCHEMA=public

# Example: Development PostgreSQL Database  
DEV_POSTGRES_DB_TYPE=POSTGRES
DEV_POSTGRES_HOSTNAME=localhost
DEV_POSTGRES_PORT=5432
DEV_POSTGRES_DATABASE=dev_analytics
DEV_POSTGRES_USERNAME=dev_user
DEV_POSTGRES_PASSWORD=dev_password
DEV_POSTGRES_SCHEMA=analytics

# Example: Oracle Enterprise Database
ORACLE_ERP_DB_TYPE=ORACLE
ORACLE_ERP_HOSTNAME=oracle.company.com
ORACLE_ERP_PORT=1521
ORACLE_ERP_DATABASE=ORCL
ORACLE_ERP_USERNAME=erp_user
ORACLE_ERP_PASSWORD=oracle_secure_pass
ORACLE_ERP_SCHEMA=HR

# Example: SQL Server Data Warehouse
SQLSERVER_DWH_DB_TYPE=SQLSERVER
SQLSERVER_DWH_HOSTNAME=dwh-sqlserver.company.com
SQLSERVER_DWH_PORT=1433
SQLSERVER_DWH_DATABASE=DataWarehouse
SQLSERVER_DWH_USERNAME=dwh_service
SQLSERVER_DWH_PASSWORD=dwh_service_password
SQLSERVER_DWH_SCHEMA=dbo

# Example: Snowflake Analytics
SNOWFLAKE_ANALYTICS_DB_TYPE=SNOWFLAKE
SNOWFLAKE_ANALYTICS_HOSTNAME=company.snowflakecomputing.com
SNOWFLAKE_ANALYTICS_PORT=443
SNOWFLAKE_ANALYTICS_DATABASE=ANALYTICS_DB
SNOWFLAKE_ANALYTICS_USERNAME=analyst_user
SNOWFLAKE_ANALYTICS_PASSWORD=snowflake_password
SNOWFLAKE_ANALYTICS_WAREHOUSE=ANALYTICS_WH
SNOWFLAKE_ANALYTICS_ACCOUNT=company_account
SNOWFLAKE_ANALYTICS_ROLE=ANALYST_ROLE
SNOWFLAKE_ANALYTICS_SCHEMA=PUBLIC

# Example: MongoDB Application Database
MONGODB_APP_DB_TYPE=MONGODB
MONGODB_APP_HOSTNAME=mongodb.company.com
MONGODB_APP_PORT=27017
MONGODB_APP_DATABASE=application_db
MONGODB_APP_USERNAME=app_mongo_user
MONGODB_APP_PASSWORD=mongo_secure_password

# Example: BigQuery Analytics (using service account)
BIGQUERY_ANALYTICS_DB_TYPE=BIGQUERY
BIGQUERY_ANALYTICS_HOSTNAME=bigquery.googleapis.com
BIGQUERY_ANALYTICS_DATABASE=my-project-id
BIGQUERY_ANALYTICS_USERNAME=service-account@project.iam.gserviceaccount.com
BIGQUERY_ANALYTICS_PASSWORD=/path/to/service-account-key.json
BIGQUERY_ANALYTICS_SCHEMA=analytics_dataset

# Example: Redshift Data Warehouse
REDSHIFT_DWH_DB_TYPE=REDSHIFT
REDSHIFT_DWH_HOSTNAME=redshift-cluster.amazonaws.com
REDSHIFT_DWH_PORT=5439
REDSHIFT_DWH_DATABASE=datawarehouse
REDSHIFT_DWH_USERNAME=dwh_user
REDSHIFT_DWH_PASSWORD=redshift_password
REDSHIFT_DWH_SCHEMA=public

# Example: SAP HANA
SAPHANA_ERP_DB_TYPE=SAPHANA
SAPHANA_ERP_HOSTNAME=hana.company.com
SAPHANA_ERP_PORT=30015
SAPHANA_ERP_DATABASE=HDB
SAPHANA_ERP_USERNAME=SYSTEM
SAPHANA_ERP_PASSWORD=hana_admin_password
SAPHANA_ERP_SCHEMA=SYSTEM

# SSL Configuration Examples
# Add SSL parameters to any connection by appending _SSL_* to the connection ID

# Example: MySQL with SSL
SECURE_MYSQL_DB_TYPE=MYSQL
SECURE_MYSQL_HOSTNAME=secure-mysql.company.com
SECURE_MYSQL_PORT=3306
SECURE_MYSQL_DATABASE=secure_db
SECURE_MYSQL_USERNAME=secure_user
SECURE_MYSQL_PASSWORD=secure_password
SECURE_MYSQL_SSL_MODE=REQUIRED
SECURE_MYSQL_SSL_CERT=/path/to/client-cert.pem
SECURE_MYSQL_SSL_KEY=/path/to/client-key.pem
SECURE_MYSQL_SSL_CA=/path/to/ca-cert.pem

# SSH Tunnel Configuration Examples
# Add SSH parameters to any connection by appending _SSH_* to the connection ID

# Example: Database through SSH tunnel
SSH_MYSQL_DB_TYPE=MYSQL
SSH_MYSQL_HOSTNAME=internal-mysql.company.com
SSH_MYSQL_PORT=3306
SSH_MYSQL_DATABASE=internal_db
SSH_MYSQL_USERNAME=internal_user
SSH_MYSQL_PASSWORD=internal_password
SSH_MYSQL_SSH_HOST=bastion.company.com
SSH_MYSQL_SSH_USER=ssh_user
SSH_MYSQL_SSH_PORT=22
SSH_MYSQL_SSH_KEY=/path/to/ssh/private/key

# Connection Pool Settings (Global)
MCP_SERVER_MAX_CONNECTIONS=50
MCP_SERVER_CONNECTION_TIMEOUT=30
MCP_SERVER_QUERY_TIMEOUT=300

# Server Configuration
MCP_SERVER_LOG_LEVEL=INFO
MCP_SERVER_DEBUG=false