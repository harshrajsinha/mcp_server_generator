# ===============================================
# SCIKIQ MCP Studio - Environment Configuration
# ===============================================
# Copy this file to .env and fill in your actual values
# NEVER commit the actual .env file with real credentials!

# ===============================================
# Azure OpenAI Configuration
# ===============================================
# Get these values from your Azure OpenAI service in Azure Portal
AZURE_OPENAI_ENDPOINT="https://your-resource-name.openai.azure.com/"
AZURE_OPENAI_KEY="your-azure-openai-api-key-here"
AZURE_OPENAI_API_KEY="your-azure-openai-api-key-here"
AZURE_OPENAI_API_VERSION="2024-02-01"
AZURE_OPENAI_DEPLOYMENT="gpt-4"
AZURE_OPENAI_DEPLOYMENT_NAME="gpt-4"
AZURE_OPENAI_EMBEDDING_DEPLOYMENT="text-embedding-ada-002"

# ===============================================
# Application Security
# ===============================================
SECRET_KEY="your-flask-secret-key-change-this-in-production"
JWT_SECRET_KEY="your-jwt-secret-key-for-authentication"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ===============================================
# Database Configuration
# ===============================================
DATABASE_URL="sqlite:///./app.db"
REDIS_URL="redis://localhost:6379"

# ===============================================
# FHIR/HL7 Healthcare Integration (Optional)
# ===============================================
FHIR_SERVER_URL="https://hapi.fhir.org/baseR4"
HL7_VERSION="2.5"

# ===============================================
# Compliance Settings
# ===============================================
HIPAA_AUDIT_LOG_ENABLED=true
GDPR_CONSENT_REQUIRED=true
DATA_RETENTION_DAYS=2555

# ===============================================
# Web Search Integration (Optional)
# ===============================================
# Get API key from https://serper.dev/
SERPER_API_KEY="your-serper-api-key-for-web-search"

# ===============================================
# Email Configuration (Optional)
# ===============================================
# For Office 365/Outlook
SMTP_HOST="smtp.office365.com"
SMTP_PORT="587"
EMAIL_USERNAME="your-email@yourcompany.com"
EMAIL_FROM="your-email@yourcompany.com"
EMAIL_PASSWORD="your-app-password-or-oauth-token"
EMAIL_DEFAULT_RECEIVER="admin@yourcompany.com"

# ===============================================
# Claude Desktop Configuration
# ===============================================
# Path to your Claude Desktop installation
# Windows example: "C:\\Users\\YourName\\AppData\\Local\\Programs\\Claude"
# macOS example: "/Applications/Claude.app/Contents/MacOS"
# Linux example: "/opt/claude" or "/usr/local/bin"
CLAUDE_DESKTOP_PATH="C:\\Users\\YourName\\AppData\\Local\\Programs\\Claude"
CLAUDE_DESKTOP_EXE="Claude.exe"

# ===============================================
# MCP Studio Configuration
# ===============================================
# Default paths for MCP server generation
# Use forward slashes for cross-platform compatibility
DEFAULT_PROJECT_PATH="C:/your-project-path/mcp-servers"
DEFAULT_SOURCE_FILE="api_routes.py"

# ===============================================
# Development Settings
# ===============================================
# Set to "development", "staging", or "production"
ENVIRONMENT="development"
DEBUG=true
LOG_LEVEL="INFO"

# ===============================================
# API Integration Settings (Optional)
# ===============================================
# Add your API base URLs and keys here
# Example for custom APIs you want to convert to MCP
# API_BASE_URL="https://api.yourservice.com/v1"
# API_KEY="your-api-key"
# API_SECRET="your-api-secret"

# ===============================================
# Proxy Settings (If behind corporate firewall)
# ===============================================
# HTTP_PROXY="http://proxy.company.com:8080"
# HTTPS_PROXY="https://proxy.company.com:8080"
# NO_PROXY="localhost,127.0.0.1"

# ===============================================
# Performance Settings
# ===============================================
# Maximum number of concurrent MCP tool calls
MAX_CONCURRENT_TOOLS=5
# Request timeout in seconds
REQUEST_TIMEOUT=30
# Rate limiting per minute
RATE_LIMIT_PER_MINUTE=60

# ===============================================
# Logging Configuration
# ===============================================
# Log file path (optional, defaults to console)
# LOG_FILE_PATH="logs/mcp_studio.log"
LOG_MAX_SIZE=10485760  # 10MB
LOG_BACKUP_COUNT=5